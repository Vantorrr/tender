# ТендерКонтур / TMA361 — локальные defaults, секреты не обязательны
PORT=43141
HOST=127.0.0.1
DATA_DIR=data
DB_FILE=tenderkontur.sqlite
# Автосинхронизация открытой ленты Норникеля каждые 6 часов (0 = выключить)
SYNC_INTERVAL_MS=21600000
# Открытая лента не требует учётных данных. Закрытые ЭТП требуют отдельного согласования/API.
PROCUREMENT_SOURCE=nornickel
# Явный демо-режим синтетических заявок (НЕ для production без согласия)
# PROCUREMENT_DEMO=0
# PROCUREMENT_API_URL=
SESSION_DAYS=7
# Записка по уже снятым цифрам сметы. Без ключа остаётся текст разбора из ячеек.
# На обычной загрузке LLM выключен; включение на upload только при OPENROUTER_ON_UPLOAD=1 + useLlm.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ON_UPLOAD=0
MAX_UPLOAD_BYTES=26214400
ANALYSIS_TIMEOUT_MS=60000
# Почта восстановления: file | memory | console | smtp | smtp-sink
MAIL_TRANSPORT=file
# Боевой SMTP (nodemailer). Без этих переменных recovery честно сообщает not live.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_TLS_REJECT=1
# SMTP_MIRROR_FILE=1
# SMTP_SINK_PORT=2525
# RECOVER_EXPOSE_CODE=1  # только локальная отладка — не включать в prod
# OCR: auto|tesseract|mock|none — auto использует локальный tesseract если установлен
OCR_PROVIDER=auto
OCR_LANGS=eng+rus
