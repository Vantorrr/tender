# ТендерКонтур / TMA361 — локальные defaults, секреты не обязательны
PORT=43141
HOST=127.0.0.1
DATA_DIR=data
DB_FILE=tenderkontur.sqlite
# автосинхронизация закупок (мс). 0 = выключить
SYNC_INTERVAL_MS=300000
SESSION_DAYS=7
# Записка по уже снятым цифрам сметы. Без ключа остаётся текст разбора из ячеек.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Почта восстановления: file (локальный sink data/mail-sink) | memory | console | smtp
MAIL_TRANSPORT=file
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RECOVER_EXPOSE_CODE=1  # только локальная отладка — не включать в prod
# OCR: auto|tesseract|mock|none — auto использует локальный tesseract если установлен
OCR_PROVIDER=auto
# OCR_LANGS=eng+rus
