# ТендерКонтур / TMA361 — локальные defaults, секреты не обязательны
PORT=43141
HOST=127.0.0.1
DATA_DIR=data
DB_FILE=tenderkontur.sqlite
# автосинхронизация закупок (мс). 0 = выключить
SYNC_INTERVAL_MS=300000
SESSION_DAYS=7
# Записка по уже снятым цифрам сметы. Без ключа остаётся текст разбора из ячеек.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Почта восстановления: memory (тесты/демо) | console | smtp
MAIL_TRANSPORT=memory
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# OCR: без провайдера — явный not_configured (см. src/server/ocr.ts)
# OCR_PROVIDER=
